# Immutable, source-attributed conversation facts.
# Inspired by huggingface/pybot bot/memory/facts.py and bot/modules/memory_store.py.
# Nodes are never mutated after insertion, so candidate state copies can safely
# share prior nodes without a losing candidate altering committed memory.

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strcmp(a: string, b: string) -> i32
}

export struct FactNode {
    owner: string,
    key: string,
    value: string,
    source: string,
    turn: i32,
    previous: ptr<FactNode>
}

export struct FactInsertResult {
    head: ptr<FactNode>,
    inserted: bool,
    invalid: bool
}

export function facts_try_note(
    head: ptr<FactNode>, owner: string, key: string,
    value: string, source: string, turn: i32
) -> FactInsertResult {
    if strcmp(owner, "") == 0 or strcmp(key, "") == 0 or strcmp(value, "") == 0 {
        return FactInsertResult { head: head, inserted: false, invalid: true }
    }
    let node: ptr<FactNode> = malloc(sizeof<FactNode>()) as ptr<FactNode>
    if node == null {
        return FactInsertResult { head: head, inserted: false, invalid: false }
    }
    node[0] = FactNode {
        owner: owner,
        key: key,
        value: value,
        source: source,
        turn: turn,
        previous: head
    }
    return FactInsertResult { head: node, inserted: true, invalid: false }
}

export function facts_note(
    head: ptr<FactNode>, owner: string, key: string,
    value: string, source: string, turn: i32
) -> ptr<FactNode> {
    if strcmp(owner, "") == 0 or strcmp(key, "") == 0 or strcmp(value, "") == 0 {
        return head
    }
    let node: ptr<FactNode> = malloc(sizeof<FactNode>()) as ptr<FactNode>
    if node == null {
        return head
    }
    node[0] = FactNode {
        owner: owner,
        key: key,
        value: value,
        source: source,
        turn: turn,
        previous: head
    }
    return node
}

export function facts_clone(head: ptr<FactNode>) -> ptr<FactNode> {
    let count: i32 = facts_count(head)
    if count == 0 {
        return null
    }
    let entries: ptr<ptr<FactNode>> = malloc((count as i64) * sizeof<ptr<FactNode>>()) as ptr<ptr<FactNode>>
    if entries == null {
        return null
    }
    let mut current: ptr<FactNode> = head
    for i in 0 to count {
        entries[i] = current
        current = current[0].previous
    }
    let mut copied: ptr<FactNode> = null
    let mut i: i32 = count
    while i > 0 {
        i = i - 1
        let source: FactNode = entries[i][0]
        let node: ptr<FactNode> = malloc(sizeof<FactNode>()) as ptr<FactNode>
        if node == null {
            facts_release(copied)
            free(entries as ptr<void>)
            return null
        }
        node[0] = FactNode {
            owner: source.owner,
            key: source.key,
            value: source.value,
            source: source.source,
            turn: source.turn,
            previous: copied
        }
        copied = node
    }
    free(entries as ptr<void>)
    return copied
}

export function facts_latest(head: ptr<FactNode>, owner: string, key: string) -> string {
    let mut node: ptr<FactNode> = head
    while node != null {
        if strcmp(node[0].owner, owner) == 0 and strcmp(node[0].key, key) == 0 {
            return node[0].value
        }
        node = node[0].previous
    }
    return ""
}

export function facts_latest_turn(head: ptr<FactNode>, owner: string, key: string) -> i32 {
    let mut node: ptr<FactNode> = head
    while node != null {
        if strcmp(node[0].owner, owner) == 0 and strcmp(node[0].key, key) == 0 {
            return node[0].turn
        }
        node = node[0].previous
    }
    return 0
}

export function facts_count(head: ptr<FactNode>) -> i32 {
    let mut count: i32 = 0
    let mut node: ptr<FactNode> = head
    while node != null {
        count = count + 1
        node = node[0].previous
    }
    return count
}

export function facts_release(head: ptr<FactNode>) {
    let mut node: ptr<FactNode> = head
    while node != null {
        let previous: ptr<FactNode> = node[0].previous
        free(node as ptr<void>)
        node = previous
    }
}

export function facts_equal(a: ptr<FactNode>, b: ptr<FactNode>) -> bool {
    let mut left: ptr<FactNode> = a
    let mut right: ptr<FactNode> = b
    while left != null and right != null {
        if strcmp(left[0].owner, right[0].owner) != 0 or
           strcmp(left[0].key, right[0].key) != 0 or
           strcmp(left[0].value, right[0].value) != 0 or
           strcmp(left[0].source, right[0].source) != 0 or
           left[0].turn != right[0].turn {
            return false
        }
        left = left[0].previous
        right = right[0].previous
    }
    return left == null and right == null
}
