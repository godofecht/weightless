import .knowledge { KnowledgeHit, knowledge_lookup, knowledge_match_score, knowledge_corpus_count, knowledge_corpus_release }

extern {
    function strcmp(a: string, b: string) -> i32
}

function same(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

function main() -> i32 {
    if knowledge_match_score("a wall socket is hot", "socket|wall socket") != 3 {
        println("FAIL: two-word phrase scores 3")
        return 1
    }
    if knowledge_match_score("a wall socket is hot", "socket") != 2 {
        println("FAIL: single word scores 2")
        return 2
    }
    if knowledge_match_score("there is a cable", "cab|car") != 0 {
        println("FAIL: partial words do not match")
        return 3
    }
    if knowledge_match_score("power socket", "socket|power socket") != 3 {
        println("FAIL: best matching alternative wins the weight")
        return 4
    }
    if knowledge_match_score("no match", "") != 0 {
        println("FAIL: empty alternatives do not match")
        return 5
    }
    if knowledge_match_score("microwave oven", "microwave oven") != 3 {
        println("FAIL: exact phrase match")
        return 6
    }
    let power: KnowledgeHit = knowledge_lookup("my wall socket is hot and buzzing")
    if not same(power.entry, "power-hot") or power.score != 7 {
        println("FAIL: power entry phrase+word+bias score")
        return 7
    }
    let screen: KnowledgeHit = knowledge_lookup("should i get a laptop stand?")
    if not same(screen.entry, "desk-screen-height") or screen.score < 8 {
        println("FAIL: desk entry specificity ranking")
        return 8
    }
    if knowledge_corpus_count() != 9 {
        println("FAIL: source-attributed corpus load")
        return 9
    }
    let pasta: KnowledgeHit = knowledge_lookup("how do i cook pasta in the microwave")
    if not same(pasta.entry, "pasta-in-the-microwave") {
        println("FAIL: source corpus entry with both keys")
        return 10
    }
    let exclusion: KnowledgeHit = knowledge_lookup("my tooth socket is hot")
    if exclusion.score > 0 {
        println("FAIL: exclusions still take precedence over positive match")
        return 11
    }
    let radiator: KnowledgeHit = knowledge_lookup("the radiator is clattering")
    if not same(radiator.entry, "radiator-plain-noise") {
        println("FAIL: source radiator noise entry")
        return 12
    }
    let laptop: KnowledgeHit = knowledge_lookup("my laptop is making a racket")
    if not same(laptop.entry, "laptop-fan-plain-noise") {
        println("FAIL: source laptop fan noise entry")
        return 13
    }
    let radiatorLeak: KnowledgeHit = knowledge_lookup("my radiator is leaking and clattering")
    if same(radiatorLeak.entry, "radiator-plain-noise") {
        println("FAIL: radiator noise exclusion")
        return 14
    }
    let wifi: KnowledgeHit = knowledge_lookup("my wifi is slow")
    if not same(wifi.entry, "wifi-slow") or wifi.score != 4 {
        println("FAIL: source wifi slow entry and literal score")
        return 15
    }
    let broadband: KnowledgeHit = knowledge_lookup("my broadband is not working")
    if not same(broadband.entry, "wifi-slow") or broadband.score != 5 {
        println("FAIL: source broadband phrase weighting")
        return 16
    }
    let unrelated: KnowledgeHit = knowledge_lookup("my laptop fan is loud")
    if same(unrelated.entry, "wifi-slow") {
        println("FAIL: wifi entry must require a connection word")
        return 17
    }
    let speedBuy: KnowledgeHit = knowledge_lookup("what broadband speed do i need")
    if not same(speedBuy.entry, "broadband-speed-to-buy") {
        println("FAIL: source broadband buying advice")
        return 18
    }
    let diet: KnowledgeHit = knowledge_lookup("is fibre broadband good for my ibs diet")
    if same(diet.entry, "broadband-speed-to-buy") {
        println("FAIL: dietary fibre exclusion")
        return 19
    }
    knowledge_corpus_release()
    println("PASS: 19 source-weighting Flow regressions")
    return 0
}
