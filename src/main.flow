import std.bytebuf { ByteBuf, bb_new, bb_putc, bb_str, bb_free }
import std.process { proc_argc, proc_argv }
import .knowledge { KnowledgeHit, knowledge_lookup, knowledge_corpus_count, knowledge_corpus_release }
import .facts { FactNode, facts_note, facts_latest, facts_latest_turn, facts_count, facts_release }
import .understanding { LineReading, understand_line }

extern {
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function getchar() -> i32
    function fflush(stream: ptr<void>) -> i32
    function isatty(fd: i32) -> i32
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

struct TurnRecord {
    user: string,
    bot: string,
    module: string
}

struct Memory {
    name: string,
    topic: string,
    lastUser: string,
    lastReply: string,
    turns: i32,
    recent: ptr<TurnRecord>,
    recentCount: i32,
    recentCapacity: i32,
    facts: ptr<FactNode>
}

struct Proposal {
    reply: string,
    module: string,
    priority: i32,
    memory: Memory
}

struct InputLine {
    text: string,
    eof: bool
}

struct CandidateSet {
    values: ptr<Proposal>,
    count: i32,
    capacity: i32
}

function fresh_memory() -> Memory {
    return Memory {
        name: "",
        topic: "",
        lastUser: "",
        lastReply: "",
        turns: 0,
        recent: null,
        recentCount: 0,
        recentCapacity: 0,
        facts: null
    }
}

function same(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

function lower_ascii(s: string) -> string {
    let buf: ptr<ByteBuf> = bb_new(64)
    let data: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    for i in 0 to n {
        let mut c: u8 = data[i]
        if c >= 65 and c <= 90 {
            c = c + 32
        }
        bb_putc(buf, c)
    }
    let result: string = bb_str(buf)
    bb_free(buf)
    return result
}

function whitespace(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

function trimmed(s: string) -> string {
    let bytes: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let mut first: i32 = 0
    let mut last: i32 = n
    while first < last and whitespace(bytes[first]) {
        first = first + 1
    }
    while last > first and whitespace(bytes[last - 1]) {
        last = last - 1
    }
    let out: ptr<ByteBuf> = bb_new(64)
    for i in first to last {
        bb_putc(out, bytes[i])
    }
    let value: string = bb_str(out)
    bb_free(out)
    return value
}

function index_of(s: string, needle: string) -> i32 {
    let n: i32 = strlen(s) as i32
    let m: i32 = strlen(needle) as i32
    if m == 0 {
        return 0
    }
    if m > n {
        return -1
    }
    let a: ptr<u8> = s as ptr<u8>
    let b: ptr<u8> = needle as ptr<u8>
    let mut i: i32 = 0
    while i <= n - m {
        let mut j: i32 = 0
        while j < m and a[i + j] == b[j] {
            j = j + 1
        }
        if j == m {
            return i
        }
        i = i + 1
    }
    return -1
}

function contains(s: string, needle: string) -> bool {
    return index_of(s, needle) >= 0
}

function first_word(s: string, word: string) -> bool {
    if index_of(s, word) != 0 {
        return false
    }
    let n: i32 = strlen(s) as i32
    let m: i32 = strlen(word) as i32
    if n == m {
        return true
    }
    let chars: ptr<u8> = s as ptr<u8>
    return whitespace(chars[m]) or chars[m] == 44 or chars[m] == 33 or chars[m] == 46
}

function extract_word(s: string, start: i32) -> string {
    let data: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let mut i: i32 = start
    while i < n and whitespace(data[i]) {
        i = i + 1
    }
    let out: ptr<ByteBuf> = bb_new(32)
    while i < n {
        let c: u8 = data[i]
        if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45) {
            break
        }
        bb_putc(out, c)
        i = i + 1
    }
    let name: string = bb_str(out)
    bb_free(out)
    return name
}

function extract_fact_value(text: string, start: i32, maxWords: i32) -> string {
    let bytes: ptr<u8> = text as ptr<u8>
    let total: i32 = strlen(text) as i32
    let out: ptr<ByteBuf> = bb_new(64)
    let mut i: i32 = start
    let mut count: i32 = 0
    while i < total and count < maxWords {
        while i < total and whitespace(bytes[i]) {
            i = i + 1
        }
        if i >= total {
            break
        }
        let part: string = extract_word(text, i)
        if same(part, "") {
            break
        }
        let low: string = lower_ascii(part)
        if same(low, "and") or same(low, "but") or same(low, "because") or same(low, "so") {
            break
        }
        if count > 0 {
            bb_putc(out, 32)
        }
        let letters: ptr<u8> = part as ptr<u8>
        let n: i32 = strlen(part) as i32
        for j in 0 to n {
            bb_putc(out, letters[j])
        }
        count = count + 1
        i = i + n
    }
    let value: string = bb_str(out)
    bb_free(out)
    return value
}

function observe(text: string, memory: Memory) -> Memory {
    let mut next: Memory = memory
    let lower: string = lower_ascii(text)
    let mut start: i32 = index_of(lower, "my name is ")
    let mut explicitName: bool = false
    if start != 0 and not (start == 4 and
        (index_of(lower, "hi, my name is ") == 0 or index_of(lower, "hey my name is ") == 0)) and
        not (start == 7 and index_of(lower, "hello, my name is ") == 0) {
        start = -1
    }
    if start >= 0 {
        explicitName = true
        start = start + 11
    } else {
        start = index_of(lower, "i'm ")
        if start != 0 and not (start == 4 and
            (index_of(lower, "hi, i'm ") == 0 or index_of(lower, "hey i'm ") == 0)) and
            not (start == 7 and index_of(lower, "hello, i'm ") == 0) {
            start = -1
        }
        if start >= 0 {
            start = start + 4
        } else {
            start = index_of(lower, "i am ")
            if start != 0 {
                start = -1
            }
            if start >= 0 {
                start = start + 5
            }
        }
    }
    if start >= 0 and not contains(lower, "?") {
        let name: string = extract_word(text, start)
        if not same(name, "") {
            let initial: u8 = (name as ptr<u8>)[0]
            if explicitName or (initial >= 65 and initial <= 90) {
                next.name = name
                next.facts = facts_note(next.facts, "self", "name", name, text, next.turns + 1)
            }
        }
    }
    if not contains(lower, "?") {
        let mut personStart: i32 = index_of(lower, "my sister's name is ")
        let mut owner: string = "sister"
        let mut prefix: string = "my sister's name is "
        if personStart < 0 {
            personStart = index_of(lower, "my brother's name is ")
            owner = "brother"
            prefix = "my brother's name is "
        }
        if personStart < 0 {
            personStart = index_of(lower, "my mum's name is ")
            owner = "mum"
            prefix = "my mum's name is "
        }
        if personStart < 0 {
            personStart = index_of(lower, "my dad's name is ")
            owner = "dad"
            prefix = "my dad's name is "
        }
        if personStart >= 0 {
            let otherName: string = extract_fact_value(text, personStart + (strlen(prefix) as i32), 2)
            next.facts = facts_note(next.facts, owner, "name", otherName, text, next.turns + 1)
        }

        let mut jobStart: i32 = index_of(lower, "my job is ")
        let mut jobPrefix: string = "my job is "
        if jobStart < 0 and first_word(lower, "i") {
            jobStart = index_of(lower, "i work as ")
            jobPrefix = "i work as "
        }
        if jobStart >= 0 {
            let jobAt: i32 = jobStart + (strlen(jobPrefix) as i32)
            let first: string = extract_word(text, jobAt)
            let article: string = lower_ascii(first)
            let mut job: string = ""
            if same(article, "a") or same(article, "an") {
                job = extract_fact_value(text, jobAt + (strlen(first) as i32) + 1, 3)
            } else {
                job = extract_fact_value(text, jobAt, 3)
            }
            next.facts = facts_note(next.facts, "self", "job", job, text, next.turns + 1)
        }
        if first_word(lower, "i") {
            let cityStart: i32 = index_of(lower, "i live in ")
            if cityStart >= 0 {
                let city: string = extract_fact_value(text, cityStart + 10, 3)
                next.facts = facts_note(next.facts, "self", "city", city, text, next.turns + 1)
            }
        }
    }
    if contains(lower, "kettle") or contains(lower, "limescale") or contains(lower, "descale") {
        next.topic = "kettle"
    }
    return next
}

function proposal(reply: string, module: string, priority: i32, memory: Memory) -> Proposal {
    return Proposal { reply: reply, module: module, priority: priority, memory: memory }
}

function candidate_set_new() -> CandidateSet {
    return CandidateSet { values: null, count: 0, capacity: 0 }
}

function candidate_set_add(set: ptr<CandidateSet>, value: Proposal) -> bool {
    if same(value.reply, "") {
        return true
    }
    if set[0].count >= set[0].capacity {
        let mut capacity: i32 = 8
        if set[0].capacity > 0 {
            if set[0].capacity > 1073741823 {
                return false
            }
            capacity = set[0].capacity * 2
        }
        let allocation: ptr<Proposal> = realloc(set[0].values as ptr<void>,
            (capacity as i64) * sizeof<Proposal>()) as ptr<Proposal>
        if allocation == null {
            return false
        }
        set[0].values = allocation
        set[0].capacity = capacity
    }
    set[0].values[set[0].count] = value
    set[0].count = set[0].count + 1
    return true
}

function candidate_set_release(set: ptr<CandidateSet>) {
    if set[0].values != null {
        free(set[0].values as ptr<void>)
    }
    set[0] = candidate_set_new()
}

function reply_was_used(memory: Memory, reply: string) -> bool {
    if same(reply, "") {
        return false
    }
    if same(memory.lastReply, reply) {
        return true
    }
    if memory.recent == null {
        return false
    }
    for i in 0 to memory.recentCount {
        if same(memory.recent[i].bot, reply) {
            return true
        }
    }
    return false
}

function prefer(current: Proposal, challenger: Proposal, memory: Memory) -> Proposal {
    if same(challenger.reply, "") {
        return current
    }
    if challenger.priority > current.priority {
        return challenger
    }
    if challenger.priority == current.priority {
        if current.priority >= 9000 {
            return current
        }
        if reply_was_used(memory, current.reply) and not reply_was_used(memory, challenger.reply) {
            return challenger
        }
    }
    return current
}

function name_reply(text: string, lower: string, memory: Memory) -> Proposal {
    if contains(lower, "what's my name") or contains(lower, "what is my name") or contains(lower, "do you remember my name") {
        if same(memory.name, "") {
            return proposal("You haven't told me your name yet.", "name_recall", 7000, memory)
        }
        return proposal("You're " + memory.name + ".", "name_recall", 7000, memory)
    }
    return proposal("", "name_recall", 7000, memory)
}

function greeting_reply(text: string, lower: string, memory: Memory, previous: Memory, reading: LineReading) -> Proposal {
    if same(reading.kind, "question") {
        return proposal("", "greeting", 500, memory)
    }
    if first_word(lower, "hello") or first_word(lower, "hi") or first_word(lower, "hey") {
        if not same(memory.name, "") and not same(memory.name, previous.name) {
            return proposal("Nice to meet you, " + memory.name + ". What can I help with?", "greeting", 500, memory)
        }
        if not same(memory.name, "") {
            return proposal("Hello, " + memory.name + ". What can I help with?", "greeting", 500, memory)
        }
        return proposal("Hello! What can I help with?", "greeting", 500, memory)
    }
    if contains(lower, "my name is ") or first_word(lower, "i'm") {
        if not same(memory.name, "") {
            return proposal("Nice to meet you, " + memory.name + ". What can I help with?", "greeting", 500, memory)
        }
    }
    if first_word(lower, "thanks") or first_word(lower, "thank") {
        return proposal("You're welcome.", "greeting", 500, memory)
    }
    if first_word(lower, "bye") or first_word(lower, "goodbye") {
        return proposal("Goodbye.", "greeting", 500, memory)
    }
    return proposal("", "greeting", 500, memory)
}

function knowledge_reply(text: string, lower: string, memory: Memory) -> Proposal {
    let hit: KnowledgeHit = knowledge_lookup(lower)
    if hit.score > 0 {
        return proposal(hit.reply, hit.module, 300 + hit.score, memory)
    }
    if contains(lower, "kettle") or contains(lower, "limescale") or contains(lower, "descale") {
        return proposal("Half fill the kettle with equal parts water and white vinegar, boil it, leave it for half an hour, then rinse thoroughly and boil fresh water twice.", "kettle", 300, memory)
    }
    if contains(lower, "how long") and same(memory.topic, "kettle") {
        return proposal("Half an hour.", "kettle_followup", 300, memory)
    }
    if contains(lower, "onions") and contains(lower, "cry") {
        return proposal("Cutting onions releases irritating sulfur compounds that react with moisture in your eyes.", "facts", 200, memory)
    }
    return proposal("", "knowledge", 200, memory)
}

function recall_reply(lower: string, memory: Memory) -> Proposal {
    if contains(lower, "which module answered two turns ago") or contains(lower, "which module answered 2 turns ago") {
        let prior: TurnRecord = recent_turn(memory, 2)
        if same(prior.module, "") {
            return proposal("I don't have a module from two turns ago.", "recall", 7000, memory)
        }
        return proposal("The module was " + prior.module + ".", "recall", 7000, memory)
    }
    if contains(lower, "what did you say two turns ago") or contains(lower, "what did you say 2 turns ago") {
        let prior: TurnRecord = recent_turn(memory, 2)
        if same(prior.bot, "") {
            return proposal("I don't have an answer from two turns ago.", "recall", 7000, memory)
        }
        return proposal("I said: " + prior.bot, "recall", 7000, memory)
    }
    if contains(lower, "what did i say two turns ago") or contains(lower, "what did i say 2 turns ago") {
        let prior: TurnRecord = recent_turn(memory, 2)
        if same(prior.user, "") {
            return proposal("I don't have a message from two turns ago.", "recall", 7000, memory)
        }
        return proposal("You said: " + prior.user, "recall", 7000, memory)
    }
    if contains(lower, "what did i just say") or contains(lower, "what did i say last") {
        if memory.turns == 0 {
            return proposal("You haven't said anything before this message.", "recall", 7000, memory)
        }
        return proposal("You said: " + memory.lastUser, "recall", 7000, memory)
    }
    if contains(lower, "what was your last answer") or contains(lower, "what did you just say") {
        if memory.turns == 0 {
            return proposal("I haven't answered yet.", "recall", 7000, memory)
        }
        return proposal("I said: " + memory.lastReply, "recall", 7000, memory)
    }
    return proposal("", "recall", 7000, memory)
}

function fact_reply(lower: string, memory: Memory) -> Proposal {
    let mut owner: string = ""
    if contains(lower, "sister's name") {
        owner = "sister"
    } elif contains(lower, "brother's name") {
        owner = "brother"
    } elif contains(lower, "mum's name") {
        owner = "mum"
    } elif contains(lower, "dad's name") {
        owner = "dad"
    }
    if not same(owner, "") and
       (contains(lower, "what") or contains(lower, "remember") or contains(lower, "tell me")) {
        let value: string = facts_latest(memory.facts, owner, "name")
        if same(value, "") {
            return proposal("You haven't told me your " + owner + "'s name.", "fact_recall", 7000, memory)
        }
        return proposal("Your " + owner + "'s name is " + value + ".", "fact_recall", 7000, memory)
    }
    if contains(lower, "what's my job") or contains(lower, "what is my job") or
       contains(lower, "what do i do for work") {
        let value: string = facts_latest(memory.facts, "self", "job")
        if same(value, "") {
            return proposal("You haven't told me your job yet.", "fact_recall", 7000, memory)
        }
        return proposal("You told me your job is " + value + ".", "fact_recall", 7000, memory)
    }
    if contains(lower, "where do i live") or contains(lower, "what city did i say i live in") {
        let value: string = facts_latest(memory.facts, "self", "city")
        if same(value, "") {
            return proposal("You haven't told me where you live.", "fact_recall", 7000, memory)
        }
        return proposal("You said you live in " + value + ".", "fact_recall", 7000, memory)
    }
    return proposal("", "fact_recall", 7000, memory)
}

function recent_turn(memory: Memory, stepsBack: i32) -> TurnRecord {
    if stepsBack < 1 or stepsBack > memory.recentCount or memory.recent == null {
        return TurnRecord { user: "", bot: "", module: "" }
    }
    return memory.recent[memory.recentCount - stepsBack]
}

function append_turn(memory: Memory, record: TurnRecord) -> Memory {
    let mut after: Memory = memory
    if after.recentCount >= after.recentCapacity {
        let mut capacity: i32 = 16
        if after.recentCapacity > 0 {
            if after.recentCapacity > 1073741823 {
                return after
            }
            capacity = after.recentCapacity * 2
        }
        let bytes: i64 = (capacity as i64) * sizeof<TurnRecord>()
        let grown: ptr<TurnRecord> = realloc(after.recent as ptr<void>, bytes) as ptr<TurnRecord>
        if grown == null {
            return after
        }
        after.recent = grown
        after.recentCapacity = capacity
    }
    after.recent[after.recentCount] = record
    after.recentCount = after.recentCount + 1
    return after
}

function release_history(memory: Memory) {
    if memory.recent != null {
        free(memory.recent as ptr<void>)
    }
    facts_release(memory.facts)
}

function after_correction(text: string, memory: Memory) -> Memory {
    let mut after: Memory = memory
    let clean: string = lower_ascii(trimmed(text))
    let mut at: i32 = index_of(clean, "call me ")
    if at == 0 {
        at = at + 8
    } elif index_of(clean, "no, call me ") == 0 {
        at = 12
    } elif index_of(clean, "actually, call me ") == 0 {
        at = 18
    } elif index_of(clean, "please call me ") == 0 {
        at = 15
    } else {
        return after
    }
    let name: string = extract_word(trimmed(text), at)
    if not same(name, "") {
        after.name = name
        after.facts = facts_note(after.facts, "self", "name", name, text, after.turns + 1)
    }
    return after
}

function after_transcript(text: string, winning: Proposal, memory: Memory) -> Memory {
    let mut after: Memory = memory
    after.lastUser = text
    after.lastReply = winning.reply
    after = append_turn(after, TurnRecord {
        user: text,
        bot: winning.reply,
        module: winning.module
    })
    return after
}

function run_after_hooks(text: string, winning: Proposal, previous: Memory) -> Memory {
    let corrected: Memory = after_correction(text, winning.memory)
    let mut recorded: Memory = after_transcript(text, winning, corrected)
    recorded.turns = previous.turns + 1
    return recorded
}

function choose(candidates: CandidateSet, previous: Memory, observed: Memory) -> Proposal {
    let mut winner: Proposal = proposal("Hello!", "fallback", -1000, observed)
    for i in 0 to candidates.count {
        winner = prefer(winner, candidates.values[i], previous)
    }
    return winner
}

function choose_for_text(candidates: CandidateSet, previous: Memory, observed: Memory, text: string) -> Proposal {
    if previous.turns > 0 and same(lower_ascii(trimmed(text)), lower_ascii(trimmed(previous.lastUser))) {
        let mut winner: Proposal = proposal("Hello!", "fallback", -1000, observed)
        for i in 0 to candidates.count {
            let candidate: Proposal = candidates.values[i]
            if not same(candidate.reply, "") and candidate.priority > winner.priority {
                winner = candidate
            }
        }
        return winner
    }
    return choose(candidates, previous, observed)
}

function observe_topic(reading: LineReading, memory: Memory) -> Memory {
    let mut next: Memory = memory
    if not same(reading.topic, "") {
        next.topic = reading.topic
    } elif same(reading.kind, "question") and not reading.followup {
        next.topic = ""
    }
    return next
}

function run_observers(text: string, previous: Memory, reading: LineReading) -> Memory {
    let withFacts: Memory = observe(text, previous)
    return observe_topic(reading, withFacts)
}

function collect_responses(text: string, reading: LineReading, previous: Memory, observed: Memory) -> CandidateSet {
    let clean: string = reading.clean
    let mut candidates: CandidateSet = candidate_set_new()
    let _g: bool = candidate_set_add_owned(&candidates, greeting_reply(text, clean, isolate_winning_transcript(observed), previous, reading), observed)
    let _k: bool = candidate_set_add_owned(&candidates, knowledge_reply(text, clean, isolate_winning_transcript(observed)), observed)
    let _n: bool = candidate_set_add_owned(&candidates, name_reply(text, clean, isolate_winning_transcript(observed)), observed)
    let _r: bool = candidate_set_add_owned(&candidates, recall_reply(clean, isolate_winning_transcript(observed)), observed)
    let _f: bool = candidate_set_add_owned(&candidates, fact_reply(clean, isolate_winning_transcript(observed)), observed)
    return candidates
}

function candidate_set_add_owned(set: ptr<CandidateSet>, value: Proposal, observed: Memory) -> bool {
    if same(value.reply, "") {
        if value.memory.recent != null and value.memory.recent != observed.recent {
            free(value.memory.recent as ptr<void>)
        }
        return true
    }
    if candidate_set_add(set, value) {
        return true
    }
    if value.memory.recent != null and value.memory.recent != observed.recent {
        free(value.memory.recent as ptr<void>)
    }
    return false
}

function release_candidate_transcripts(candidates: CandidateSet, observed: Memory, retained: ptr<TurnRecord>) {
    for i in 0 to candidates.count {
        let candidate: Proposal = candidates.values[i]
        if candidate.memory.recent != null and candidate.memory.recent != observed.recent and candidate.memory.recent != retained {
            free(candidate.memory.recent as ptr<void>)
        }
    }
}

function isolate_winning_transcript(memory: Memory) -> Memory {
    if memory.recent == null or memory.recentCount == 0 {
        return memory
    }
    let bytes: i64 = (memory.recentCount as i64) * sizeof<TurnRecord>()
    let copied: ptr<TurnRecord> = realloc(null, bytes) as ptr<TurnRecord>
    if copied == null {
        return memory
    }
    for i in 0 to memory.recentCount {
        copied[i] = memory.recent[i]
    }
    let mut isolated: Memory = memory
    isolated.recent = copied
    isolated.recentCapacity = memory.recentCount
    return isolated
}

function turn_with_candidate_trace(text: string, state: ptr<Memory>, traceCandidates: bool) -> Proposal {
    let previous: Memory = state[0]
    let reading: LineReading = understand_line(text, previous.topic)
    let observed: Memory = run_observers(text, previous, reading)
    let mut candidates: CandidateSet = collect_responses(text, reading, previous, observed)
    let winner: Proposal = choose_for_text(candidates, previous, observed, text)
    if traceCandidates {
        for i in 0 to candidates.count {
            let candidate: Proposal = candidates.values[i]
            println("WEIGHTLESS_CANDIDATE\t" + candidate.module + "\t" + candidate.reply)
        }
    }
    let mut committed: Proposal = winner
    committed.memory = isolate_winning_transcript(winner.memory)
    if committed.memory.recent != previous.recent and previous.recent != null {
        free(previous.recent as ptr<void>)
    }
    state[0] = run_after_hooks(text, committed, previous)
    release_candidate_transcripts(candidates, observed, committed.memory.recent)
    candidate_set_release(&candidates)
    return committed
}

function turn(text: string, state: ptr<Memory>) -> Proposal {
    return turn_with_candidate_trace(text, state, false)
}

function read_line() -> InputLine {
    let buffer: ptr<ByteBuf> = bb_new(128)
    let mut eof: bool = false
    let mut n: i32 = 0
    while true {
        let c: i32 = getchar()
        if c < 0 {
            eof = true
            break
        }
        if c == 10 {
            break
        }
        if c != 13 {
            bb_putc(buffer, c as u8)
            n = n + 1
        }
    }
    let line: string = bb_str(buffer)
    bb_free(buffer)
    return InputLine { text: line, eof: eof and n == 0 }
}

function run_self_tests() -> i32 {
    let emptyReading: LineReading = understand_line("unmatched nonsense input", "")
    let emptyMemory: Memory = fresh_memory()
    let mut collectedEmptyCandidates: CandidateSet = collect_responses("unmatched nonsense input", emptyReading, emptyMemory, emptyMemory)
    if collectedEmptyCandidates.count != 0 {
        println("FAIL: responder collection must omit empty proposals")
        candidate_set_release(&collectedEmptyCandidates)
        return 72
    }
    candidate_set_release(&collectedEmptyCandidates)
    let mut candidateSource: Memory = fresh_memory()
    let _candidateSeed: Proposal = turn("hello", &candidateSource)
    let candidateReading: LineReading = understand_line("hi", candidateSource.topic)
    let candidateObserved: Memory = run_observers("hi", candidateSource, candidateReading)
    let mut independentCandidates: CandidateSet = collect_responses("hi", candidateReading, candidateSource, candidateObserved)
    if independentCandidates.count < 1 {
        println("FAIL: expected a responder proposal for snapshot ownership")
        return 82
    }
    for i in 0 to independentCandidates.count {
        if independentCandidates.values[i].memory.recent == candidateObserved.recent {
            println("FAIL: responder must receive pre-invocation transcript snapshot")
            return 83
        }
        for j in 0 to i {
            if independentCandidates.values[i].memory.recent == independentCandidates.values[j].memory.recent {
                println("FAIL: responders must not share transcript snapshot storage")
                return 84
            }
        }
    }
    independentCandidates.values[0].memory.recent[0] = TurnRecord { user: "mutated", bot: "mutated", module: "mutated" }
    if not same(candidateSource.recent[0].user, "hello") {
        println("FAIL: candidate transcript mutation leaked into session")
        return 85
    }
    release_candidate_transcripts(independentCandidates, candidateObserved, null)
    candidate_set_release(&independentCandidates)
    release_history(candidateSource)
    let mut isolationSource: Memory = fresh_memory()
    let _isolationTurn: Proposal = turn("hello", &isolationSource)
    let mut isolationCopy: Memory = isolate_winning_transcript(isolationSource)
    if isolationCopy.recent == isolationSource.recent or isolationCopy.recentCount != isolationSource.recentCount {
        println("FAIL: winning transcript must have independent storage")
        return 75
    }
    isolationCopy.recent[0] = TurnRecord { user: "changed", bot: "changed", module: "changed" }
    if not same(isolationSource.recent[0].user, "hello") {
        println("FAIL: winning transcript copy must not mutate previous history")
        return 76
    }
    free(isolationCopy.recent as ptr<void>)
    release_history(isolationSource)
    let mut candidateMemory: Memory = fresh_memory()
    let _candidateTurn: Proposal = turn("hello", &candidateMemory)
    let isolationReading: LineReading = understand_line("what is my name?", candidateMemory.topic)
    let mut isolatedCandidates: CandidateSet = collect_responses("what is my name?", isolationReading, candidateMemory, candidateMemory)
    if isolatedCandidates.count == 0 or isolatedCandidates.values[0].memory.recent == candidateMemory.recent {
        println("FAIL: responder candidate transcript must be isolated")
        return 77
    }
    isolatedCandidates.values[0].memory.recent[0] = TurnRecord { user: "candidate-only", bot: "", module: "" }
    if not same(candidateMemory.recent[0].user, "hello") {
        println("FAIL: candidate mutation must not change committed transcript")
        return 78
    }
    release_candidate_transcripts(isolatedCandidates, candidateMemory)
    candidate_set_release(&isolatedCandidates)
    release_history(candidateMemory)
    let mut longTranscript: Memory = fresh_memory()
    for i in 0 to 40 {
        let _historyTurn: Proposal = turn("hello", &longTranscript)
    }
    if longTranscript.recentCount != 40 or longTranscript.recentCapacity < 40 {
        println("FAIL: transcript growth must preserve every turn")
        return 79
    }
    let mut copiedTranscript: Memory = isolate_winning_transcript(longTranscript)
    if copiedTranscript.recent == longTranscript.recent or copiedTranscript.recentCount != 40 {
        println("FAIL: grown transcript must copy into independent storage")
        return 80
    }
    copiedTranscript.recent[39] = TurnRecord { user: "altered", bot: "altered", module: "altered" }
    if not same(longTranscript.recent[39].user, "hello") {
        println("FAIL: grown transcript snapshot must isolate tail mutations")
        return 81
    }
    free(copiedTranscript.recent as ptr<void>)
    release_history(longTranscript)
    let mut memory: Memory = fresh_memory()
    let a: Proposal = turn("hi, i'm Sam", &memory)
    if not same(a.reply, "Nice to meet you, Sam. What can I help with?") {
        println("FAIL: greeting and observer")
        return 1
    }
    let b: Proposal = turn("what's my name?", &memory)
    if not same(b.reply, "You're Sam.") or not same(b.module, "name_recall") {
        println("FAIL: remembered name and priority")
        return 2
    }
    let c: Proposal = turn("my kettle has limescale", &memory)
    if not same(c.module, "kettle") {
        println("FAIL: knowledge responder")
        return 3
    }
    let d: Proposal = turn("how long does that take?", &memory)
    if not same(d.reply, "Half an hour.") {
        println("FAIL: inherited topic")
        return 4
    }
    if memory.turns != 4 {
        println("FAIL: turn history count")
        return 5
    }
    release_history(memory)
    memory = fresh_memory()
    let e: Proposal = turn("what's my name?", &memory)
    if not same(e.reply, "You haven't told me your name yet.") {
        println("FAIL: reset isolation")
        return 6
    }
    let f: Proposal = turn("unmatched nonsense input", &memory)
    if not same(f.reply, "Hello!") {
        println("FAIL: fallback")
        return 7
    }
    let last: TurnRecord = recent_turn(memory, 1)
    if not same(last.user, "unmatched nonsense input") or not same(last.module, "fallback") {
        println("FAIL: appended turn history")
        return 8
    }
    let m: Proposal = turn("what did i just say?", &memory)
    if not same(m.reply, "You said: unmatched nonsense input") {
        println("FAIL: contextual recall")
        return 9
    }
    if memory.recentCount != 3 or memory.turns != 3 {
        println("FAIL: transcript length")
        return 10
    }
    let mut longMemory: Memory = fresh_memory()
    for j in 0 to 36 {
        let _ignored: Proposal = turn("hello", &longMemory)
    }
    if longMemory.recentCount != 36 or longMemory.turns != 36 or longMemory.recentCapacity < 36 {
        println("FAIL: dynamically growing transcript count")
        return 11
    }
    let newest: TurnRecord = recent_turn(longMemory, 1)
    let oldest: TurnRecord = recent_turn(longMemory, 36)
    if not same(newest.user, "hello") or not same(newest.module, "greeting") or not same(oldest.user, "hello") {
        println("FAIL: full transcript retrieval")
        return 12
    }
    let mut candidateTest: CandidateSet = candidate_set_new()
    let _empty: bool = candidate_set_add(&candidateTest, proposal("", "none", 0, longMemory))
    let _low: bool = candidate_set_add(&candidateTest, proposal("low", "low", 5, longMemory))
    let _high: bool = candidate_set_add(&candidateTest, proposal("high", "high", 50, longMemory))
    let _medium: bool = candidate_set_add(&candidateTest, proposal("medium", "medium", 10, longMemory))
    let picked: Proposal = choose(candidateTest, longMemory, longMemory)
    if not same(picked.module, "high") or candidateTest.count != 3 {
        println("FAIL: candidate arbitration")
        return 13
    }
    candidate_set_release(&candidateTest)
    for k in 0 to 100 {
        let _ignoredMore: Proposal = turn("hello", &longMemory)
    }
    if longMemory.recentCount != 136 or longMemory.turns != 136 {
        println("FAIL: history growth past 128")
        return 14
    }
    let first: TurnRecord = recent_turn(longMemory, 136)
    if not same(first.user, "hello") or not same(first.module, "greeting") {
        println("FAIL: earliest transcript preserved")
        return 15
    }
    let mut domainMemory: Memory = fresh_memory()
    let power: Proposal = turn("my wall socket is hot and buzzing", &domainMemory)
    if not same(power.module, "answers") or not contains(power.reply, "unplug it at the wall") {
        println("FAIL: source-derived electrical entry")
        return 16
    }
    let dental: Proposal = turn("my tooth socket is hot", &domainMemory)
    if same(dental.module, "answers") {
        println("FAIL: electrical entry exclusion on dental context")
        return 17
    }
    let setup: Proposal = turn("should i get a laptop stand?", &domainMemory)
    if not same(setup.module, "answers") or not contains(setup.reply, "external keyboard") {
        println("FAIL: source-derived desk setup entry")
        return 18
    }
    let screen: Proposal = turn("my monitor is broken", &domainMemory)
    if same(screen.module, "answers") {
        println("FAIL: desk setup broken-screen exclusion")
        return 19
    }
    let parking: Proposal = turn("is it legal to park on the pavement?", &domainMemory)
    if not same(parking.module, "answers") or not contains(parking.reply, "traffic order") {
        println("FAIL: source-derived parking entry")
        return 20
    }
    let cable: Proposal = turn("the cable is long", &domainMemory)
    if same(cable.module, "answers") {
        println("FAIL: knowledge entry requires both matching groups")
        return 21
    }
    if knowledge_corpus_count() != 5 {
        println("FAIL: source corpus count")
        return 22
    }
    let pasta: Proposal = turn("how do i cook pasta in the microwave", &domainMemory)
    if not same(pasta.module, "answers") or not contains(pasta.reply, "8 to 10 minutes") {
        println("FAIL: corpus pasta entry")
        return 23
    }
    let eggs: Proposal = turn("how do i scramble eggs in the microwave", &domainMemory)
    if not same(eggs.module, "answers") or not contains(eggs.reply, "30-second bursts") {
        println("FAIL: corpus egg entry")
        return 24
    }
    let vegetables: Proposal = turn("how do i steam broccoli in the microwave", &domainMemory)
    if not same(vegetables.module, "answers") or not contains(vegetables.reply, "microwave-safe") {
        println("FAIL: corpus vegetables entry")
        return 25
    }
    let reheat: Proposal = turn("how long to reheat pasta in the microwave", &domainMemory)
    if same(reheat.module, "answers") {
        println("FAIL: reheating exclusion")
        return 26
    }
    let foodClock: Proposal = turn("i left my lunch out overnight, is it safe", &domainMemory)
    if not same(foodClock.module, "answers") or not contains(foodClock.reply, "two hours") {
        println("FAIL: corpus left-out clock")
        return 27
    }
    let schoolKit: Proposal = turn("what should my son take on his first day at secondary school", &domainMemory)
    if not same(schoolKit.module, "answers") or not contains(schoolKit.reply, "pencil case") {
        println("FAIL: corpus secondary school kit")
        return 28
    }
    let mut expanded: CandidateSet = candidate_set_new()
    let mut shared: Memory = fresh_memory()
    shared.topic = "original"
    for i in 0 to 40 {
        let mut local: Memory = shared
        local.topic = "loser"
        let _added: bool = candidate_set_add(&expanded, proposal("losing", "candidate", i, local))
        if not _added {
            println("FAIL: dynamic candidate set allocation")
            return 29
        }
    }
    let mut winnerMemory: Memory = shared
    winnerMemory.topic = "committed"
    let _winnerAdded: bool = candidate_set_add(&expanded,
        proposal("winning", "last", 100, winnerMemory))
    let pickedMany: Proposal = choose(expanded, shared, shared)
    if expanded.count != 41 or expanded.capacity < 41 or
       not same(pickedMany.module, "last") or
       not same(pickedMany.memory.topic, "committed") or
       not same(shared.topic, "original") {
        println("FAIL: isolated candidate memory and arbitrary candidate count")
        return 30
    }
    let updated: Memory = run_after_hooks("hello", pickedMany, shared)
    if not same(updated.topic, "committed") or not same(shared.topic, "original") or
       updated.recentCount != 1 or not same(updated.lastReply, "winning") {
        println("FAIL: winner-only memory commit")
        return 31
    }
    candidate_set_release(&expanded)
    let mut corrected: Memory = fresh_memory()
    let _init: Proposal = turn("hi, i'm Sam", &corrected)
    let _call: Proposal = turn("no, call me Alex", &corrected)
    let remembered: Proposal = turn("what's my name?", &corrected)
    if not same(remembered.reply, "You're Alex.") {
        println("FAIL: post-choice correction hook")
        return 32
    }
    let mut unidentified: Memory = fresh_memory()
    let _mood: Proposal = turn("i'm hungry", &unidentified)
    let unknown: Proposal = turn("what's my name?", &unidentified)
    if not same(unknown.reply, "You haven't told me your name yet.") {
        println("FAIL: ordinary adjective incorrectly stored as name")
        return 34
    }
    let _explicitLower: Proposal = turn("my name is alex", &unidentified)
    let explicitRecall: Proposal = turn("what's my name?", &unidentified)
    if not same(explicitRecall.reply, "You're alex.") {
        println("FAIL: explicit lowercase name introduction")
        return 35
    }
    let mut transcriptMemory: Memory = fresh_memory()
    let _one: Proposal = turn("hello", &transcriptMemory)
    let _two: Proposal = turn("thanks", &transcriptMemory)
    let twoBack: Proposal = turn("what did i say two turns ago?", &transcriptMemory)
    if not same(twoBack.reply, "You said: hello") or not same(twoBack.module, "recall") {
        println("FAIL: structured transcript two-turn recall")
        return 50
    }
    release_history(transcriptMemory)
    let mut emptyTranscript: Memory = fresh_memory()
    let unavailable: Proposal = turn("what did i say 2 turns ago?", &emptyTranscript)
    if not same(unavailable.reply, "I don't have a message from two turns ago.") {
        println("FAIL: missing older transcript entry")
        return 51
    }
    release_history(emptyTranscript)
    let mut observedSnapshot: Memory = fresh_memory()
    observedSnapshot.topic = "shared"
    let mut losingSnapshot: Memory = observedSnapshot
    let mut winningSnapshot: Memory = observedSnapshot
    losingSnapshot.topic = "loser mutation"
    winningSnapshot.topic = "winner mutation"
    let mut snapshotCandidates: CandidateSet = candidate_set_new()
    let _losingAdded: bool = candidate_set_add(&snapshotCandidates,
        proposal("losing response", "loser", 100, losingSnapshot))
    let _winningAdded: bool = candidate_set_add(&snapshotCandidates,
        proposal("winning response", "winner", 200, winningSnapshot))
    let snapshotWinner: Proposal = choose(snapshotCandidates, observedSnapshot, observedSnapshot)
    let committedSnapshot: Memory = run_after_hooks("snapshot probe", snapshotWinner, observedSnapshot)
    if not same(observedSnapshot.topic, "shared") or
       not same(snapshotWinner.memory.topic, "winner mutation") or
       not same(committedSnapshot.topic, "winner mutation") or
       committedSnapshot.recentCount != 1 {
        println("FAIL: independent responder scalar snapshots and winner-only commit")
        return 52
    }
    candidate_set_release(&snapshotCandidates)
    release_history(committedSnapshot)
    let mut repeatMemory: Memory = fresh_memory()
    repeatMemory = append_turn(repeatMemory, TurnRecord {
        user: "first", bot: "Already answered", module: "general"
    })
    repeatMemory = append_turn(repeatMemory, TurnRecord {
        user: "second", bot: "Different answer", module: "general"
    })
    repeatMemory.lastReply = "Different answer"
    let repeated: Proposal = proposal("Already answered", "general_a", 200, repeatMemory)
    let novel: Proposal = proposal("New answer", "general_b", 200, repeatMemory)
    let noveltyWinner: Proposal = prefer(repeated, novel, repeatMemory)
    if not same(noveltyWinner.module, "general_b") {
        println("FAIL: nonadjacent repeated reply must yield to novel equal-priority answer")
        return 53
    }
    let repeatHigher: Proposal = prefer(
        proposal("New answer", "lower", 200, repeatMemory),
        proposal("Already answered", "higher", 201, repeatMemory), repeatMemory)
    if not same(repeatHigher.module, "higher") {
        println("FAIL: repeat avoidance must not override higher priority")
        return 54
    }
    release_history(repeatMemory)
    let mut repeatedQuestion: Memory = fresh_memory()
    repeatedQuestion.lastUser = "What should I do?"
    repeatedQuestion.turns = 1
    repeatedQuestion.lastReply = "Original response"
    let mut repeatedCandidates: CandidateSet = candidate_set_new()
    let _old: bool = candidate_set_add(&repeatedCandidates,
        proposal("Original response", "original", 200, repeatedQuestion))
    let _new: bool = candidate_set_add(&repeatedCandidates,
        proposal("Novel response", "novel", 200, repeatedQuestion))
    let repeatPick: Proposal = choose_for_text(repeatedCandidates, repeatedQuestion,
        repeatedQuestion, "what should i do?")
    if not same(repeatPick.module, "original") {
        println("FAIL: consecutive same question preserves highest-priority original answer")
        return 55
    }
    let changedPick: Proposal = choose_for_text(repeatedCandidates, repeatedQuestion,
        repeatedQuestion, "what else should i do?")
    if not same(changedPick.module, "novel") {
        println("FAIL: different question still prefers novel equal-priority reply")
        return 56
    }
    candidate_set_release(&repeatedCandidates)
    let mut botTranscript: Memory = fresh_memory()
    let firstBot: Proposal = turn("hi", &botTranscript)
    let _secondBot: Proposal = turn("what is my name?", &botTranscript)
    let oldBot: Proposal = turn("what did you say two turns ago?", &botTranscript)
    if not same(oldBot.reply, "I said: " + firstBot.reply) or not same(oldBot.module, "recall") {
        println("FAIL: two-turn bot transcript recall")
        return 54
    }
    release_history(botTranscript)
    let mut noBotTranscript: Memory = fresh_memory()
    let missingBot: Proposal = turn("what did you say 2 turns ago?", &noBotTranscript)
    if not same(missingBot.reply, "I don't have an answer from two turns ago.") {
        println("FAIL: missing bot transcript history")
        return 55
    }
    release_history(noBotTranscript)
    let mut moduleTranscript: Memory = fresh_memory()
    let firstModule: Proposal = turn("hi", &moduleTranscript)
    let _moduleSecond: Proposal = turn("what is my name?", &moduleTranscript)
    let oldModule: Proposal = turn("which module answered two turns ago?", &moduleTranscript)
    if not same(oldModule.reply, "The module was " + firstModule.module + ".") or
       not same(oldModule.module, "recall") {
        println("FAIL: historical module attribution from structured transcript")
        return 57
    }
    release_history(moduleTranscript)
    let mut noModuleTranscript: Memory = fresh_memory()
    let absentModule: Proposal = turn("which module answered 2 turns ago?", &noModuleTranscript)
    if not same(absentModule.reply, "I don't have a module from two turns ago.") {
        println("FAIL: missing historical module attribution")
        return 58
    }
    release_history(noModuleTranscript)
    let misleadingFollowup: LineReading = understand_line("What is Thatcher?", "kettle")
    if misleadingFollowup.followup or not same(misleadingFollowup.topic, "") {
        println("FAIL: embedded 'that' must not inherit previous topic")
        return 59
    }
    let genuineFollowup: LineReading = understand_line("What is that?", "kettle")
    if not genuineFollowup.followup or not same(genuineFollowup.topic, "kettle") {
        println("FAIL: standalone anaphoric 'that' must inherit topic")
        return 60
    }
    let trainingTopic: LineReading = understand_line("How is my training going?", "")
    if not same(trainingTopic.topic, "") {
        println("FAIL: training must not be classified as transport")
        return 61
    }
    let pluggedTopic: LineReading = understand_line("I unplugged the cable", "")
    if not same(pluggedTopic.topic, "") {
        println("FAIL: unplugged must not be classified as electricity")
        return 62
    }
    let trainTopic: LineReading = understand_line("When is the train?", "")
    if not same(trainTopic.topic, "transport") {
        println("FAIL: standalone train must retain transport topic")
        return 63
    }
    let plugTopic: LineReading = understand_line("Is this plug safe?", "")
    if not same(plugTopic.topic, "electricity") {
        println("FAIL: standalone plug must retain electricity topic")
        return 64
    }
    let mut correctedAlias: Memory = fresh_memory()
    let _initialAlias: Proposal = turn("my name is Alex", &correctedAlias)
    let _changedAlias: Proposal = turn("actually, call me Morgan", &correctedAlias)
    let aliasRecall: Proposal = turn("what is my name?", &correctedAlias)
    if not same(aliasRecall.reply, "You're Morgan.") or
       not same(facts_latest(correctedAlias.facts, "self", "name"), "Morgan") {
        println("FAIL: actually-prefixed name correction")
        return 65
    }
    release_history(correctedAlias)
    let mut politeAlias: Memory = fresh_memory()
    let _politeChange: Proposal = turn("please call me Taylor", &politeAlias)
    let politeRecall: Proposal = turn("what is my name?", &politeAlias)
    if not same(politeRecall.reply, "You're Taylor.") {
        println("FAIL: polite name correction")
        return 66
    }
    release_history(politeAlias)
    if not is_reset_command(" /RESET ") or not is_reset_command("/reset") or
       is_reset_command("/reset now") or is_reset_command("reset") {
        println("FAIL: reset command parsing across input modes")
        return 67
    }
    let mut spacedCorrection: Memory = fresh_memory()
    let _spaced: Proposal = turn("   actually, call me Morgan   ", &spacedCorrection)
    let spacedRecall: Proposal = turn("what is my name?", &spacedCorrection)
    if not same(spacedRecall.reply, "You're Morgan.") or
       not same(facts_latest(spacedCorrection.facts, "self", "name"), "Morgan") {
        println("FAIL: whitespace-prefixed correction offset")
        return 68
    }
    release_history(spacedCorrection)
    let mut embeddedName: Memory = fresh_memory()
    let _embeddedNameTurn: Proposal = turn("She said my name is Morgan yesterday", &embeddedName)
    if not same(embeddedName.name, "") or
       not same(facts_latest(embeddedName.facts, "self", "name"), "") {
        println("FAIL: embedded explicit name must not set self memory")
        return 73
    }
    release_history(embeddedName)
    let mut greetingName: Memory = fresh_memory()
    let _greetingNameTurn: Proposal = turn("Hello, my name is Morgan", &greetingName)
    if not same(greetingName.name, "Morgan") {
        println("FAIL: greeting-prefixed explicit name must be observed")
        return 74
    }
    release_history(greetingName)
    let mut quotedSelf: Memory = fresh_memory()
    let _quotedSelfTurn: Proposal = turn("She said I'm Morgan yesterday", &quotedSelf)
    if not same(quotedSelf.name, "") or
       not same(facts_latest(quotedSelf.facts, "self", "name"), "") {
        println("FAIL: quoted first-person statement must not set user name")
        return 67
    }
    release_history(quotedSelf)
    let mut actualSelf: Memory = fresh_memory()
    let _actualSelfTurn: Proposal = turn("I'm Morgan", &actualSelf)
    if not same(actualSelf.name, "Morgan") {
        println("FAIL: first-person introduction must set user name")
        return 68
    }
    release_history(actualSelf)
    let mut observerSeed: Memory = fresh_memory()
    observerSeed.topic = "kettle"
    let nameReading: LineReading = understand_line("My name is Ada", observerSeed.topic)
    let withName: Memory = run_observers("My name is Ada", observerSeed, nameReading)
    let orderedReading: LineReading = understand_line("What is Thatcher?", withName.topic)
    let orderedState: Memory = run_observers("What is Thatcher?", withName, orderedReading)
    if not same(orderedState.name, "Ada") or not same(orderedState.topic, "") or
       not same(observerSeed.name, "") or not same(observerSeed.topic, "kettle") {
        println("FAIL: ordered observers must preserve fact updates while clearing unrelated topic")
        return 70
    }
    let mut hookMemory: Memory = fresh_memory()
    let hookReply: Proposal = turn("  call me Iris", &hookMemory)
    let hookRecord: TurnRecord = recent_turn(hookMemory, 1)
    if not same(hookMemory.name, "Iris") or
       not same(hookRecord.user, "  call me Iris") or
       not same(hookRecord.bot, hookReply.reply) or
       not same(hookRecord.module, hookReply.module) or
       hookMemory.turns != 1 {
        println("FAIL: ordered correction and transcript after-hooks")
        return 70
    }
    release_history(hookMemory)
    let mut safetyMemory: Memory = fresh_memory()
    safetyMemory.lastReply = "Careful safety response"
    let safetyFirst: Proposal = proposal("Careful safety response", "safety", 9000, safetyMemory)
    let safetySecond: Proposal = proposal("Alternative safety response", "other_safety", 9000, safetyMemory)
    let safetyChosen: Proposal = prefer(safetyFirst, safetySecond, safetyMemory)
    if not same(safetyChosen.module, "safety") {
        println("FAIL: safety band must preserve original module ordering on ties")
        return 47
    }
    let ordinaryChosen: Proposal = prefer(safetyFirst,
        proposal("Ordinary response", "general", 8999, safetyMemory), safetyMemory)
    if not same(ordinaryChosen.module, "safety") {
        println("FAIL: ordinary responders cannot displace safety band")
        return 48
    }
    let strongerChosen: Proposal = prefer(safetyFirst,
        proposal("Higher safety response", "high_safety", 9001, safetyMemory), safetyMemory)
    if not same(strongerChosen.module, "high_safety") {
        println("FAIL: higher safety priority still wins")
        return 49
    }
    let mut emptyCandidates: CandidateSet = candidate_set_new()
    let emptyPicked: Proposal = choose(emptyCandidates, corrected, corrected)
    if not same(emptyPicked.module, "fallback") or not same(emptyPicked.reply, "Hello!") {
        println("FAIL: empty candidate set fallback")
        return 33
    }
    candidate_set_release(&emptyCandidates)
    let mut factMemory: Memory = fresh_memory()
    let _relative: Proposal = turn("my sister's name is Lucy", &factMemory)
    let sister: Proposal = turn("what's my sister's name?", &factMemory)
    if not same(sister.reply, "Your sister's name is Lucy.") or
       facts_count(factMemory.facts) != 1 {
        println("FAIL: attributed relative name")
        return 36
    }
    let unknownSelf: Proposal = turn("what's my name?", &factMemory)
    if not same(unknownSelf.reply, "You haven't told me your name yet.") {
        println("FAIL: relative facts never become self facts")
        return 37
    }
    let _correctSister: Proposal = turn("actually my sister's name is Maya", &factMemory)
    let sisterCorrected: Proposal = turn("what's my sister's name?", &factMemory)
    if not same(sisterCorrected.reply, "Your sister's name is Maya.") or
       facts_latest_turn(factMemory.facts, "sister", "name") != 4 {
        println("FAIL: corrected relative fact and source chronology")
        return 38
    }
    let _selfIntro: Proposal = turn("my name is Sam", &factMemory)
    let selfRecall: Proposal = turn("what's my name?", &factMemory)
    if not same(selfRecall.reply, "You're Sam.") or
       not same(facts_latest(factMemory.facts, "self", "name"), "Sam") {
        println("FAIL: self name stored separately from relatives")
        return 39
    }
    let _job: Proposal = turn("i work as a teacher", &factMemory)
    let jobRecall: Proposal = turn("what is my job?", &factMemory)
    if not same(jobRecall.reply, "You told me your job is teacher.") {
        println("FAIL: job observation and recall")
        return 40
    }
    let _city: Proposal = turn("i live in Cambridge", &factMemory)
    let cityRecall: Proposal = turn("where do i live?", &factMemory)
    if not same(cityRecall.reply, "You said you live in Cambridge.") {
        println("FAIL: city observation and recall")
        return 41
    }
    let _rename: Proposal = turn("no, call me Alex", &factMemory)
    let renamed: Proposal = turn("what's my name?", &factMemory)
    if not same(renamed.reply, "You're Alex.") or
       not same(facts_latest(factMemory.facts, "self", "name"), "Alex") or
       facts_count(factMemory.facts) != 6 {
        println("FAIL: corrected self identity in append-only fact log")
        return 42
    }
    release_history(factMemory)
    factMemory = fresh_memory()
    let forgotten: Proposal = turn("what's my sister's name?", &factMemory)
    if not same(forgotten.reply, "You haven't told me your sister's name.") or
       facts_count(factMemory.facts) != 0 {
        println("FAIL: reset removes owned fact history")
        return 43
    }
    release_history(factMemory)
    let mut phrases: Memory = fresh_memory()
    let _placePhrase: Proposal = turn("I live in New York", &phrases)
    let _jobPhrase: Proposal = turn("my job is software engineer", &phrases)
    let _familyPhrase: Proposal = turn("my sister's name is Mary Jane", &phrases)
    if not same(facts_latest(phrases.facts, "self", "city"), "New York") or
       not same(facts_latest(phrases.facts, "self", "job"), "software engineer") or
       not same(facts_latest(phrases.facts, "sister", "name"), "Mary Jane") or
       facts_count(phrases.facts) != 3 {
        println("FAIL: multiword attributed fact extraction")
        return 44
    }
    release_history(phrases)
    let mut topicMemory: Memory = fresh_memory()
    let _kettleTopic: Proposal = turn("my kettle has limescale", &topicMemory)
    let unrelated: Proposal = turn("how long does a train take?", &topicMemory)
    if same(unrelated.module, "kettle_followup") or same(topicMemory.topic, "kettle") {
        println("FAIL: fresh questions must not inherit an unrelated previous topic")
        return 45
    }
    let mut prefixedQuestion: Memory = fresh_memory()
    let screenHelp: Proposal = turn("Hi, should i get a laptop stand?", &prefixedQuestion)
    if not same(screenHelp.module, "answers") {
        println("FAIL: greeting prefix must not hijack an actual question")
        return 46
    }
    release_history(topicMemory)
    release_history(prefixedQuestion)
    release_history(unidentified)
    release_history(corrected)
    release_history(updated)
    release_history(domainMemory)
    release_history(memory)
    release_history(longMemory)
    knowledge_corpus_release()
    println("PASS: 85 Flow runtime regression scenarios")
    return 0
}

function show_help() {
    println("Weightless: a rule-based chatbot in Flow")
    println("Usage: weightless [-p TEXT] [-i] [-v] [-s N] [--trace] [--trace-candidates] [--knowledge-stats] [--self-test]")
    println("Commands in interactive mode: /help /reset /exit")
}

function is_reset_command(text: string) -> bool {
    return same(lower_ascii(trimmed(text)), "/reset")
}

function main() -> i32 {
    let mut hasPrompt: bool = false
    let mut prompt: string = ""
    let mut interactiveFlag: bool = false
    let mut verbose: bool = false
    let mut trace: bool = false
    let mut traceCandidates: bool = false
    let mut i: i32 = 1
    while i < proc_argc() {
        let arg: string = proc_argv(i)
        if same(arg, "-p") or same(arg, "--prompt") {
            if i + 1 >= proc_argc() {
                println("Missing prompt text")
                return 2
            }
            i = i + 1
            prompt = proc_argv(i)
            hasPrompt = true
        } elif same(arg, "-i") or same(arg, "--interactive") {
            interactiveFlag = true
        } elif same(arg, "-v") or same(arg, "--verbose") {
            verbose = true
        } elif same(arg, "--trace") {
            trace = true
        } elif same(arg, "--trace-candidates") {
            trace = true
            traceCandidates = true
        } elif same(arg, "-s") or same(arg, "--seed") {
            if i + 1 >= proc_argc() {
                println("Missing seed")
                return 2
            }
            i = i + 1
        } elif same(arg, "--self-test") {
            return run_self_tests()
        } elif same(arg, "--knowledge-stats") {
            println(knowledge_corpus_count())
            knowledge_corpus_release()
            return 0
        } elif same(arg, "--help") or same(arg, "-h") {
            show_help()
            return 0
        } elif same(arg, "--version") {
            println("weightless 0.1.0")
            return 0
        } else {
            println("Unknown option: " + arg)
            return 2
        }
        i = i + 1
    }

    let interactive: bool = interactiveFlag or (not hasPrompt and isatty(0) != 0)
    let mut memory: Memory = fresh_memory()
    if interactive {
        println("Weightless, written in Flow. No weights or training.")
        println("Type /help for commands, /reset to forget, /exit to quit.")
    }
    if hasPrompt {
        let result: Proposal = turn_with_candidate_trace(prompt, &memory, traceCandidates)
        if trace {
            println("WEIGHTLESS_RESULT\t" + result.module + "\t" + result.reply)
        } elif interactive {
            println("user: " + prompt)
            println("weightless: " + result.reply)
        } else {
            println(result.reply)
        }
        if verbose {
            println("[module: " + result.module + "]")
        }
        if not interactive {
            release_history(memory)
            knowledge_corpus_release()
            return 0
        }
    }
    while true {
        if interactive {
            print("user: ")
            let _flushed: i32 = fflush(null)
        }
        let line: InputLine = read_line()
        if line.eof {
            break
        }
        let cmd: string = lower_ascii(trimmed(line.text))
        if is_reset_command(line.text) {
            release_history(memory)
            memory = fresh_memory()
            if interactive {
                println("New conversation.")
            }
            continue
        }
        if interactive {
            if same(cmd, "/exit") or same(cmd, "/quit") or same(cmd, "/bye") {
                break
            }
            if same(cmd, "/help") {
                show_help()
                continue
            }
            if same(cmd, "") {
                continue
            }
        }
        let result: Proposal = turn_with_candidate_trace(line.text, &memory, traceCandidates)
        if trace {
            println("WEIGHTLESS_RESULT\t" + result.module + "\t" + result.reply)
        } elif interactive {
            println("weightless: " + result.reply)
        } else {
            println(result.reply)
        }
        if verbose {
            println("[module: " + result.module + "]")
        }
    }
    release_history(memory)
    knowledge_corpus_release()
    return 0
}
