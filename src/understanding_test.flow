import .understanding { LineReading, understand_line }

extern {
    function strcmp(a: string, b: string) -> i32
}

function equal(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

function main() -> i32 {
    let empty: LineReading = understand_line(" \t ", "")
    if not equal(empty.kind, "empty") or not equal(empty.intent, "empty") {
        println("FAIL: empty reading")
        return 1
    }
    let greeting: LineReading = understand_line(" Hello ", "")
    if not equal(greeting.kind, "greeting") or not equal(greeting.clean, "hello") {
        println("FAIL: greeting normalization")
        return 2
    }
    let thankYou: LineReading = understand_line("Thanks, that helped", "")
    if not equal(thankYou.kind, "thanks") or not equal(thankYou.intent, "thanks") {
        println("FAIL: gratitude is not a question")
        return 3
    }
    let embeddedQuestion: LineReading = understand_line(
        "Thanks, one more thing - how do i clean the oven?", ""
    )
    if not equal(embeddedQuestion.kind, "question") or not equal(embeddedQuestion.wants, "steps") {
        println("FAIL: later question survives politeness prefix")
        return 4
    }
    let timeAsk: LineReading = understand_line("How long does that take?", "kettle")
    if not equal(timeAsk.kind, "question") or not equal(timeAsk.wants, "time") or
       not equal(timeAsk.topic, "kettle") or not timeAsk.followup {
        println("FAIL: follow-up answer shape and inherited topic")
        return 5
    }
    let freshAsk: LineReading = understand_line("How long does a train take?", "kettle")
    if not equal(freshAsk.topic, "transport") or freshAsk.followup {
        println("FAIL: a new named topic must not inherit a stale kettle")
        return 6
    }
    let quantity: LineReading = understand_line("How much does that cost?", "")
    if not equal(quantity.wants, "amount") {
        println("FAIL: amount questions")
        return 7
    }
    let why: LineReading = understand_line("Why did the engine fail?", "")
    if not equal(why.wants, "reason") {
        println("FAIL: reason question")
        return 8
    }
    let yesNo: LineReading = understand_line("Can I do this?", "")
    if not equal(yesNo.wants, "yesno") {
        println("FAIL: yes-no question")
        return 9
    }
    let correction: LineReading = understand_line("Actually, I meant the kettle", "")
    if not equal(correction.intent, "correction") or not equal(correction.topic, "kettle") {
        println("FAIL: correction intent with specific topic")
        return 10
    }
    let multiSpace: LineReading = understand_line("   HELLO    there  ", "")
    if not equal(multiSpace.clean, "hello there") {
        println("FAIL: collapse whitespace without losing words")
        return 11
    }
    let also: LineReading = understand_line("Also, can I use it again?", "kettle")
    if not also.followup or not equal(also.topic, "kettle") {
        println("FAIL: also follow-up inherits context")
        return 12
    }
    let whatIf: LineReading = understand_line("What if it breaks?", "electricity")
    if not whatIf.followup or not equal(whatIf.topic, "electricity") {
        println("FAIL: what-if follow-up inherits context")
        return 13
    }
    let howAbout: LineReading = understand_line("How about tomorrow?", "transport")
    if not howAbout.followup or not equal(howAbout.topic, "transport") {
        println("FAIL: how-about follow-up inherits context")
        return 14
    }
    let newTopic: LineReading = understand_line("Also, can I use the train?", "kettle")
    if newTopic.followup or not equal(newTopic.topic, "transport") {
        println("FAIL: explicit new topic overrides follow-up opener")
        return 15
    }
    let noContext: LineReading = understand_line("What if it breaks?", "")
    if noContext.followup or not equal(noContext.topic, "") {
        println("FAIL: first-turn follow-up must not invent context")
        return 16
    }
    let frequency: LineReading = understand_line("How often should I do that?", "kettle")
    if not frequency.followup or not equal(frequency.topic, "kettle") {
        println("FAIL: frequency follow-up inherits context")
        return 17
    }
    let thenAsk: LineReading = understand_line("Then what?", "transport")
    if not thenAsk.followup or not equal(thenAsk.topic, "transport") {
        println("FAIL: then follow-up inherits context")
        return 18
    }
    let insteadAsk: LineReading = understand_line("Instead, can I use it?", "electricity")
    if not insteadAsk.followup or not equal(insteadAsk.topic, "electricity") {
        println("FAIL: instead follow-up inherits context")
        return 19
    }
    let anotherTopic: LineReading = understand_line("Another train?", "kettle")
    if anotherTopic.followup or not equal(anotherTopic.topic, "transport") {
        println("FAIL: explicit train topic overrides another opener")
        return 20
    }
    let noPrevious: LineReading = understand_line("Then what?", "")
    if noPrevious.followup or not equal(noPrevious.topic, "") {
        println("FAIL: then opener cannot fabricate a prior topic")
        return 21
    }
    println("PASS: 21 structured-understanding Flow scenarios")
    return 0
}
